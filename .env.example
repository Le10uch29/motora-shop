# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings -> API page. When deploying (e.g. to Vercel), all three
# of these must also be set in the hosting project's environment variables —
# .env.local is never uploaded, so a deploy without them will 500 on any
# admin page that needs the service-role client (e.g. /admin/staff/admins).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
# Secret/service-role key — server-only, bypasses RLS. Never prefix with
# NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SECRET_KEY=
